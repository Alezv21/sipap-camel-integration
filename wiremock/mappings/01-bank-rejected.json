{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/banks/.+/transfer",
    "headers": {
      "X-Transaction-Id": { "matches": ".*(ERROR|REJECT).*" }
    }
  },
  "response": {
    "status": 422,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "estado": "RECHAZADA",
      "mensaje": "Banco mock rechazó la transferencia"
    }
  }
}
